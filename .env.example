# ============================================================
#  CREDENCIALES Y CONFIGURACIÓN  (copiar a .env y rellenar)
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos REMOTA (MySQL / MariaDB) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Conexión segura contra el servidor MySQL remoto (true/false)
DB_SSL=false
# Conexiones simultáneas del pool
DB_POOL_LIMIT=10

# --- Seguridad / JWT ---
# Cadena secreta para firmar los tokens (¡cambiar en producción!)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# Duración del token: 8h, 1d, 30m...
JWT_EXPIRES_IN=8h

# Longitud mínima de contraseña
MIN_PASSWORD_ADMIN=8
MIN_PASSWORD_CLIENTE=6

# Contraseña FIJA que el servidor usa en el registro de tarjetas/usuarios.
# El front NO la envía en el alta (si la manda, se ignora) y el login de
# tarjeta autentica con este valor. Obligatoria: si falta, no arranca.
USUARIO_PASSWORD=123123

# --- Reglas de negocio ---

# Códigos de camareros válidos, separados por coma.
# Si está vacío, se acepta cualquier código no vacío (solo se registra).
# Ejemplo: CAMARERO_CODIGOS=ANA-01,LUIS-02
CAMARERO_CODIGOS=

# Si la operación "no estándar" (ver README) exige nombre en el SERVIDOR.
# true  -> el servidor rechaza la operación si no viene nombre + código camarero
# false -> lo decide solo el front (el servidor sólo registra lo que llegue)
EXIGIR_NOMBRE_SERVIDOR=true

# Punto de corte a partir del cual un incremento de puntos se considera
# "demasiado grande" y exige nombre/camarero (solo aplica si EXIGIR_NOMBRE_SERVIDOR=true)
UMBRAL_PUNTOS_NOMBRE=100

# --- Google Wallet ---
# ID de emisor (aparece delante del punto en cada CLASS_ID: <issuerId>.<idRandomLargo>)
GOOGLE_WALLET_ISSUER_ID=333333333333333
# Ruta al JSON de la service account (relativa a la raíz del proyecto o absoluta).
# El fichero contiene la clave PRIVADA: nunca se sube a git.
GOOGLE_WALLET_CREDENTIALS=service-account.json
# URL base del front (reservas). El QR de la tarjeta NO la incluye:
# el QR sólo contiene el id de la tarjeta y el front arma la URL real
# en su página exclusiva con lector de QR.
FRONT_URL=https://tu-front.com
